<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!-- Blurred Background Image -->
    <ImageView
        android:id="@+id/background_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/cd_background_image"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Dark Gradient Scrim Overlay for guaranteed legibility -->
    <View
        android:id="@+id/background_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_screen_scrim"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Pure OLED Black Scrim (0 nits true black when OLED mode is active) -->
    <View
        android:id="@+id/oled_black_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:alpha="0"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top Left Search Toggle Button (Portrait initial state) -->
    <ImageButton
        android:id="@+id/btn_search_toggle"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="56dp"
        android:background="@drawable/bg_circle_translucent"
        android:contentDescription="@string/cd_search"
        android:elevation="20dp"
        android:translationZ="20dp"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_search"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#FFFFFFFF" />

    <!-- Top Right Settings Button (Portrait initial state) -->
    <ImageButton
        android:id="@+id/btn_settings"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="56dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/bg_circle_translucent"
        android:contentDescription="@string/cd_settings"
        android:elevation="20dp"
        android:translationZ="20dp"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_settings"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#FFFFFFFF" />

    <!-- Portrait Song List Panel (Starts directly below small top cover header) -->
    <LinearLayout
        android:id="@+id/portrait_song_list_panel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="116dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_song_list_container"
        android:clickable="true"
        android:focusable="true"
        android:elevation="10dp"
        android:translationZ="10dp"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/badge_audio_quality"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Tabs for Songs | Queue -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tab_songs_portrait"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:text="Songs"
                android:textColor="#FF00FFCC"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="|"
                android:textColor="#40FFFFFF"
                android:textSize="14sp" />

            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/tab_queue_portrait"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingVertical="8dp"
                    android:text="Queue"
                    android:textColor="#80FFFFFF"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/btn_clear_queue_portrait"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@null"
                    android:padding="5dp"
                    android:src="@drawable/ic_close"
                    android:visibility="gone"
                    app:tint="#B3FFFFFF" />
            </RelativeLayout>
        </LinearLayout>

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewpager_portrait"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </LinearLayout>

    <!-- Portrait Lyrics Panel (Floating directly over blurred artwork, no tinted box or border) -->
    <FrameLayout
        android:id="@+id/portrait_lyrics_panel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="116dp"
        android:layout_marginBottom="8dp"
        android:background="@null"
        android:clickable="true"
        android:focusable="false"
        android:elevation="0dp"
        android:translationZ="0dp"
        android:outlineProvider="none"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/badge_audio_quality"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- RecyclerView for Synced / Timed Lyrics -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_synced_lyrics"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="80dp"
            android:paddingBottom="100dp"
            android:overScrollMode="never"
            android:outlineProvider="none"
            android:background="@null"
            android:scrollbars="none"
            android:visibility="gone" />

        <!-- Scrollable Plain Lyrics View (fallback when synced is not available) -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_plain_lyrics"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="30dp"
            android:paddingBottom="60dp"
            android:overScrollMode="never"
            android:outlineProvider="none"
            android:background="@null"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="20dp"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/tv_plain_lyrics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start|center_vertical"
                    android:lineSpacingExtra="10dp"
                    android:textColor="#E0FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:shadowColor="#99000000"
                    android:shadowRadius="6" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="48dp"
                    android:layout_marginBottom="24dp"
                    android:text="@string/lyrics_attribution"
                    android:textColor="#40FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Loading State -->
        <LinearLayout
            android:id="@+id/lyrics_loading_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:indeterminateTint="#FF00FFCC" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/lyrics_loading"
                android:textColor="#80FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Instrumental State -->
        <LinearLayout
            android:id="@+id/lyrics_instrumental_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_music_note"
                app:tint="#60FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/lyrics_instrumental"
                android:textColor="#FFFFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/lyrics_instrumental_subtitle"
                android:textColor="#70FFFFFF"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Empty / Error State -->
        <LinearLayout
            android:id="@+id/lyrics_empty_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_lyrics_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/lyrics_not_found"
                android:textColor="#B3FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_lyrics_empty_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/lyrics_not_found_subtitle"
                android:textColor="#60FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btn_lyrics_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_quality_badge"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="Retry"
                android:textColor="#FF00FFCC"
                android:textSize="13sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

    </FrameLayout>

    <!-- Small Top Header Audio Visualizer (Active when list is open & music playing) -->
    <LinearLayout
        android:id="@+id/header_visualizer"
        android:layout_width="32dp"
        android:layout_height="24dp"
        android:layout_marginEnd="80dp"
        android:layout_marginTop="68dp"
        android:elevation="30dp"
        android:translationZ="30dp"
        android:gravity="bottom|center_horizontal"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:id="@+id/bar1"
            android:layout_width="3dp"
            android:layout_height="18dp"
            android:layout_marginEnd="3dp"
            android:background="#FFFFFFFF" />

        <View
            android:id="@+id/bar2"
            android:layout_width="3dp"
            android:layout_height="18dp"
            android:layout_marginEnd="3dp"
            android:background="#FFFFFFFF" />

        <View
            android:id="@+id/bar3"
            android:layout_width="3dp"
            android:layout_height="18dp"
            android:layout_marginEnd="3dp"
            android:background="#FFFFFFFF" />

        <View
            android:id="@+id/bar4"
            android:layout_width="3dp"
            android:layout_height="18dp"
            android:background="#FFFFFFFF" />
    </LinearLayout>

    <!-- Song Title -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="4dp"
        android:elevation="30dp"
        android:translationZ="30dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="#FFFFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/tv_artist"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="Song Title" />

    <!-- Song Artist -->
    <TextView
        android:id="@+id/tv_artist"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="12dp"
        android:elevation="30dp"
        android:translationZ="30dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="#B3FFFFFF"
        android:textSize="18sp"
        app:layout_constraintBottom_toTopOf="@id/badge_audio_quality"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="Artist Name" />

    <!-- Incoming Card Cover (For circular carousel gesture) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_cover_incoming"
        android:layout_width="300dp"
        android:layout_height="285dp"
        android:layout_marginTop="128dp"
        android:elevation="40dp"
        android:translationZ="40dp"
        android:outlineAmbientShadowColor="#FF000000"
        android:outlineSpotShadowColor="#FF000000"
        android:visibility="gone"
        app:cardCornerRadius="32dp"
        app:cardElevation="40dp"
        app:cardMaxElevation="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeWidth="0dp">

        <ImageView
            android:id="@+id/cover_image_incoming"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/mustre" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Main Card Cover -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_cover"
        android:layout_width="300dp"
        android:layout_height="285dp"
        android:layout_marginTop="128dp"
        android:elevation="50dp"
        android:translationZ="50dp"
        android:outlineAmbientShadowColor="#FF000000"
        android:outlineSpotShadowColor="#FF000000"
        app:cardCornerRadius="32dp"
        app:cardElevation="50dp"
        app:cardMaxElevation="50dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeWidth="0dp">

        <ImageView
            android:id="@+id/cover_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/mustre" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Audio Quality Badge -->
    <LinearLayout
        android:id="@+id/badge_audio_quality"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_quality_badge"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        app:layout_constraintBottom_toTopOf="@id/seekbar_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageView
            android:id="@+id/iv_quality_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="@string/cd_quality_icon"
            android:src="@drawable/ic_lossless"
            app:tint="#D0FFFFFF" />

        <TextView
            android:id="@+id/tv_quality_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#D0FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="Lossless • 24-bit / 96 kHz" />
    </LinearLayout>

    <!-- Playback Controls -->
    <LinearLayout
        android:id="@+id/controls_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="56dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageButton
            android:id="@+id/btn_lyrics"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/btn_circle_ripple"
            android:contentDescription="@string/cd_lyrics"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_lyrics"
            app:tint="#B3FFFFFF" />

        <ImageButton
            android:id="@+id/btn_previous"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/btn_circle_ripple"
            android:contentDescription="@string/cd_previous"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_previous"
            app:tint="#FFFFFFFF" />

        <ImageButton
            android:id="@+id/btn_play_pause"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/btn_circle_ripple"
            android:contentDescription="@string/cd_play_pause"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_play"
            app:tint="#FFFFFFFF" />

        <ImageButton
            android:id="@+id/btn_next"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/btn_circle_ripple"
            android:contentDescription="@string/cd_next"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_next"
            app:tint="#FFFFFFFF" />

        <ImageButton
            android:id="@+id/btn_song_list_toggle"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/btn_circle_ripple"
            android:contentDescription="@string/cd_playlist"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_playlist"
            app:tint="#B3FFFFFF" />

    </LinearLayout>

    <!-- Audio Seekbar Container -->
    <LinearLayout
        android:id="@+id/seekbar_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="20dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/controls_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <SeekBar
            android:id="@+id/seekbar_audio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="0"
            android:secondaryProgress="0"
            android:progressBackgroundTint="#40FFFFFF"
            android:secondaryProgressTint="#A0FFFFFF"
            android:progressTint="#FFFFFFFF"
            android:thumbTint="#FFFFFFFF" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="12dp">

            <TextView
                android:id="@+id/tv_current_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="@string/default_time"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_total_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="@string/default_time"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp" />
        </RelativeLayout>
    </LinearLayout>

    <!-- Expanding Translucent Glassmorphic Search Container (Portrait Overlay) -->
    <LinearLayout
        android:id="@+id/search_bar_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="52dp"
        android:background="@drawable/bg_search_container_dark"
        android:elevation="60dp"
        android:translationZ="60dp"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Top Input Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <ImageView
                android:id="@+id/iv_search_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_search"
                app:tint="#B3FFFFFF" />

            <EditText
                android:id="@+id/et_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/search_hint"
                android:imeOptions="actionSearch|flagNoExtractUi"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textColorHint="#80FFFFFF"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/btn_search_close"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_close"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_close"
                app:tint="#B3FFFFFF" />
        </LinearLayout>

        <!-- Divider Line -->
        <View
            android:id="@+id/search_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="4dp"
            android:background="#25FFFFFF"
            android:visibility="gone" />

        <!-- Search Results List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_search_results"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:clipToPadding="false"
            android:scrollbars="vertical"
            android:visibility="gone"
            tools:listitem="@layout/item_song" />
