<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_item_ripple"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="10dp"
    android:paddingVertical="8dp">

    <!-- Song Icon / Album Art Thumbnail -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_song_icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_circle_translucent"
        android:contentDescription="@null"
        android:padding="2dp"
        android:scaleType="centerCrop"
        android:src="@drawable/mustre"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Small" />

    <!-- Title and Artist Column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_item_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="Song Title" />

        <TextView
            android:id="@+id/tv_item_artist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#B3FFFFFF"
            android:textSize="11sp"
            tools:text="Artist Name" />
    </LinearLayout>

    <!-- Small HQ Indicator Badge -->
    <TextView
        android:id="@+id/tv_item_hq"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_quality_badge"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:textColor="#D0FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        tools:text="HQ" />

    <!-- Play Icon -->
    <ImageView
        android:id="@+id/iv_song_play_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@null"
        android:padding="2dp"
        android:src="@drawable/ic_play"
        app:tint="#B3FFFFFF" />

</LinearLayout>
